# Copy into ignored .env in THIS directory after inspecting the source.
SCREENHAND_API_URL=http://127.0.0.1:3013
SCREENHAND_LOCAL_CONTROL_PLANE_URL=http://127.0.0.1:3013
SCREENHAND_TASK_CONSOLE_PORT=3027
SCREENHAND_TASK_CONSOLE_URL=http://127.0.0.1:3027
# Explicitly choose and validate a planner; no real key is included.
SCREENHAND_AUTONOMOUS_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-private-key
# Or SCREENHAND_AUTONOMOUS_PROVIDER=codex, with local CLI/login available.
# SCREENHAND_CODEX_MODEL=an-available-model-for-this-account
# Keep visible keyboard text entry disabled for initial acceptance.
SCREENHAND_VISIBLE_INPUT=0
