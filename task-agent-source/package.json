{
  "name": "screenhand-control-console",
  "version": "0.3.0",
  "private": true,
  "bin": {
    "screenhand": "./bin/screenhand.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:3011": "node scripts/dev-vision-console.mjs",
    "dev:3011:ui": "NEXT_PUBLIC_SCREENHAND_LOCAL_CONTROL_PLANE_PROXY=1 WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 127.0.0.1 --port 3011",
    "dev:3012": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 127.0.0.1 --port 3012",
    "black:driver": "python3 bridge/black_arm_driver.py",
    "black:node": "tsx bridge/black_arm_node.ts",
    "fleet": "tsx bridge/fleet_supervisor.ts",
    "relay:feature-frames": "node scripts/relay-feature-frames.mjs",
    "auto-setup": "tsx auto-setup/server.ts",
    "control-plane": "tsx agent/server.ts",
    "agent:run": "tsx agent/run-general-agent.ts",
    "agent:evaluate": "tsx agent/evaluate-active-world.ts",
    "agent:curriculum": "tsx agent/generate-active-world-curriculum.ts",
    "agent:curriculum:feedback": "tsx agent/process-curriculum-feedback.ts",
    "agent:benchmark": "tsx agent/evaluate-physical-mobile-world.ts",
    "agent:fast-gate": "tsx agent/evaluate-fast-runtime.ts",
    "agent:grounding-gate": "tsx agent/evaluate-visual-grounding.ts",
    "agent:real-grounding-gate": "tsx agent/evaluate-real-camera-grounding.ts",
    "agent:real-grounding:bootstrap": "tsx agent/evaluate-real-camera-grounding.ts --allow-development-only",
    "agent:hover-replay:diagnostic": "tsx agent/evaluate-speculative-hover-replay.ts --allow-development-only",
    "agent:gate": "tsx agent/evaluate-promotion-gate.ts",
    "agent:realtime": "tsx agent/run-realtime-agent.ts",
    "agent:realtime:server": "tsx agent/realtime/server.ts",
    "perception:server": "tsx agent/local-perception/server.ts",
    "test:perception": "tsx --test agent/local-perception/*.test.ts",
    "control:local": "tsx agent/local-control/run.ts",
    "control:task": "tsx agent/local-control/run-task.ts",
    "control:autonomous": "tsx agent/local-control/run-autonomous.ts",
    "tasks:server": "tsx agent/task-console/server.ts",
    "test:task-console": "tsx --test agent/task-console/*.test.ts",
    "control:benchmark-models": "tsx agent/local-control/run-model-benchmark.ts",
    "test:model-benchmark": "tsx --test agent/local-control/model-benchmark.test.ts",
    "test:local-control": "tsx --test agent/local-control/*.test.ts agent/local-perception/*.test.ts",
    "setup": "./scripts/setup-macos.sh",
    "onboard": "node bin/screenhand.mjs onboard",
    "screenhand": "node bin/screenhand.mjs",
    "local": "npm run build && ./start-local.sh",
    "mcp": "tsx mcp/server.ts",
    "remote:gateway": "tsx bridge/remote_gateway.ts",
    "remote": "./start-remote.sh",
    "black": "./start-black.sh",
    "doctor": "./scripts/doctor.sh",
    "acceptance:real": "node scripts/record-real-acceptance.mjs",
    "example:first-tap": "node examples/first-tap.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:3012": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start --hostname 127.0.0.1 --port 3012",
    "stable": "python3 scripts/supervisor.py",
    "stable:status": "python3 scripts/supervisor.py --status-once",
    "stable:install": "npm run build && python3 scripts/install_supervisor_macos.py",
    "test": "npm run test:unit && npm run test:mcp && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "tsx --test agent/*.test.ts agent/active-world/*.test.ts agent/realtime/*.test.ts bridge/*.test.ts auto-setup/*.test.ts && python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:mcp": "node --test tests/mcp-protocol.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "dotenv": "^17.4.2",
    "jpeg-js": "^0.4.4",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.3",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "wrangler": "^4.127.0"
  },
  "type": "module"
}
